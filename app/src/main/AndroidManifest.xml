<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The app needs the internet to reach Firebase, and location for the phone
        capability the final project requires: the manager stamps a shift's real
        position when publishing it, and employees see how far away each shift is.

        Declaring the permissions here is only half the job: from Android 6 the
        user must also grant location at runtime, which LocationHelper handles.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShiftManager"
        tools:targetApi="31">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sign-up: who you are, then which business you belong to -->
        <activity android:name=".ProfileSetupActivity" />
        <activity android:name=".BusinessSetupActivity" />
        <activity android:name=".CreateBusinessActivity" />

        <!-- Manager side -->
        <activity android:name=".MainActivity" />
        <activity android:name=".CreateShiftActivity" />
        <activity android:name=".StaffDirectoryActivity" />

        <!-- Employee side -->
        <activity android:name=".EmployeeActivity" />
        <activity android:name=".MyShiftsActivity" />

        <!-- Opened by both roles: the manager can approve here, the employee reads only -->
        <activity android:name=".ShiftDetailActivity" />

        <!-- Admin side: the app owner's overview of every business and account -->
        <activity android:name=".AdminActivity" />

    </application>

</manifest>