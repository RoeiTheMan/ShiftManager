<?xml version="1.0" encoding="utf-8"?>
<!--
    The manager's "publish a new shift" form. HW2 describes this as the view the manager
    reaches from the + button, where the date, time and description are entered before
    the shift is confirmed.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".CreateShiftActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="@string/action_back"
            android:textColor="#1976D2"
            android:textSize="16sp" />

        <!-- Reads "New shift" or "Edit shift"; the same form does both. -->
        <TextView
            android:id="@+id/tvCreateShiftTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/create_shift_title"
            android:textColor="#1976D2"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="jobTitle"
            android:hint="@string/hint_title"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:hint="@string/hint_description"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <!-- Read-only fields: tapping them opens a picker, so the stored format is always valid. -->
        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:hint="@string/hint_date"
            android:inputType="none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etStartTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:hint="@string/hint_start_time"
                android:inputType="none" />

            <EditText
                android:id="@+id/etEndTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:hint="@string/hint_end_time"
                android:inputType="none" />
        </LinearLayout>

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="postalAddress"
            android:hint="@string/hint_location"
            android:inputType="textCapSentences" />

        <!--
            Two ways to put real coordinates on a shift. Looking the address up matters
            because a manager is usually not standing at the venue when they publish it,
            and without it the address above is only a label.
        -->
        <Button
            android:id="@+id/btnFindAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FFFFFF"
            android:text="@string/action_find_address"
            android:textColor="#1976D2" />

        <!-- The GPS capability: saves the phone's position onto the shift. -->
        <Button
            android:id="@+id/btnUseMyLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFFFFF"
            android:text="@string/action_use_my_location"
            android:textColor="#1976D2" />

        <TextView
            android:id="@+id/tvCapturedLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#2E7D32"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Location captured (32.0853, 34.7818)"
            tools:visibility="visible" />

        <!--
            Who the shift needs, one row per staff role.

            The rows are built at runtime from the roles this business defined when it was
            set up, so the form offers waiter/cook/bartender rather than a single headcount.
            A shift is not "6 people", it is 3 waiters, 1 cook and 2 bartenders.
        -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/shift_who_is_needed"
            android:textColor="#212121"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/shift_who_is_needed_help"
            android:textColor="#757575"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/containerRoleRequirements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnSaveShift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#1976D2"
            android:text="@string/action_save"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
