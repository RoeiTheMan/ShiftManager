<?xml version="1.0" encoding="utf-8"?>
<!--
    One person under a business heading on the admin screen.

    Indented past the heading so it reads as belonging to the business above it. Tapping
    opens the account details, which deliberately do NOT include a password: Firebase
    Auth stores a salted hash and exposes it to nobody, the app owner included.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="32dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvAdminPersonName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#212121"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/tvAdminPersonStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Noa · employee" />

    <TextView
        android:id="@+id/tvAdminPersonEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#757575"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/tvAdminPersonStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAdminPersonName"
        tools:text="emp1@test.com" />

    <TextView
        android:id="@+id/tvAdminPersonStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Member" />

</androidx.constraintlayout.widget.ConstraintLayout>
