    <!--
        Says plainly why there is no password here. Firebase Auth stores a salted hash and
        gives the original back to nobody, the app's owner included, so the honest answer
        belongs on screen rather than as an unexplained missing field.
    -->
    <string name="admin_person_details">Email: %1$s\nRole: %2$s\nAccount created: %3$s\n\nPasswords cannot be shown to anyone, including the app owner — Firebase stores them only as a one-way hash. Send a reset email instead.</string>
